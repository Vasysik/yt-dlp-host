HOST_PROJECT_DIR=/opt/yt-dlp-host
ADMIN_API_KEY=replace-with-a-long-random-secret

# State backend: sqlite (recommended) or json (legacy live-file mode).
STORAGE_BACKEND=sqlite
MAX_WORKERS=4
LOG_LEVEL=INFO

# YouTube authenticated/bot-challenge support:
# YTDLP_COOKIES_FILE=/app/cookies/youtube.txt
# YTDLP_IMPERSONATE=chrome
# YTDLP_PROXY=http://user:pass@proxy.example:8080

# Compatibility/security switches:
LEGACY_PUBLIC_STATUS=true
LEGACY_PUBLIC_FILES=true
ALLOW_PRIVATE_URLS=false

# Limits:
REQUEST_LIMIT=60
REQUEST_WINDOW_MINUTES=10
DEFAULT_QUOTA_BYTES=5368709120
SERVER_QUOTA_BYTES=21474836480
QUOTA_WINDOW_MINUTES=10
INITIAL_QUOTA_RESERVATION_BYTES=67108864
QUOTA_MONITOR_SECONDS=0.5
TASK_RETENTION_MINUTES=10
PORT=5000
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT_SECONDS=60
